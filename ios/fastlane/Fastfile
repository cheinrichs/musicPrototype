default_platform(:ios)

platform :ios do
  desc "Archive, sign, and upload to TestFlight"
  lane :beta do
    # Create an isolated keychain for CI (cleaned up automatically after the lane)
    keychain_name = "fastlane_tmp_keychain"
    keychain_password = ENV["MATCH_KEYCHAIN_PASSWORD"]

    create_keychain(
      name: keychain_name,
      password: keychain_password,
      default_keychain: true,
      unlock: true,
      timeout: 3600,
      lock_when_sleeps: false
    )

    # Import the distribution certificate into the CI keychain
    import_certificate(
      certificate_path: "/tmp/distribution.p12",
      certificate_password: ENV["APPLE_CERTIFICATE_PASSWORD"],
      keychain_name: keychain_name,
      keychain_password: keychain_password
    )

    # Install the App Store distribution provisioning profile
    install_provisioning_profile(path: "/tmp/distribution.mobileprovision")

    # Authenticate with App Store Connect (API key — no password/2FA needed)
    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_API_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_API_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_API_KEY_CONTENT"],
      is_key_content_base64: true
    )

    # Archive and export the .ipa. Assumes `flutter build ios --release --no-codesign`
    # has already run (see the GitHub Actions workflow) so Pods/Flutter.framework
    # are in place — gym just needs to archive + sign + export.
    #
    # `export_options` only controls the export (archive → ipa) step. The
    # archive step itself still uses whatever signing style is baked into the
    # Xcode project, which defaults to Automatic on a fresh Flutter project —
    # and Automatic signing can't work in CI (no interactive Apple ID login).
    #
    # update_code_signing_settings switches JUST the "Runner" app target to
    # manual signing with our imported cert + profile. Scoping it to Runner
    # only matters: an earlier attempt used xcargs, which applies build
    # settings to every target in the project — including CocoaPods framework
    # targets (Pods-Runner, flutter_soloud, shared_preferences_foundation,
    # etc.), which aren't apps and don't support having a provisioning
    # profile assigned at all. Those stay on whatever CocoaPods set them to.
    profile_name = ENV["APPLE_PROVISIONING_PROFILE_NAME"] || "Ear Trainer App Store"

    update_code_signing_settings(
      use_automatic_signing: false,
      path: "Runner.xcodeproj",
      team_id: ENV["APPLE_TEAM_ID"],
      code_sign_identity: "Apple Distribution",
      profile_name: profile_name,
      targets: ["Runner"],
      build_configurations: ["Release"]
    )

    gym(
      workspace: "Runner.xcworkspace",
      scheme: "Runner",
      configuration: "Release",
      export_method: "app-store",
      output_directory: "output",
      output_name: "EarTrainer.ipa",
      export_options: {
        method: "app-store",
        provisioningProfiles: {
          "com.eartrainer.earTrainer" => profile_name
        }
      }
    )

    # Upload to TestFlight; don't wait for Apple's processing in CI
    pilot(
      api_key: api_key,
      ipa: "output/EarTrainer.ipa",
      skip_waiting_for_build_processing: true
    )

    # Clean up the temporary keychain
    delete_keychain(name: keychain_name)
  end
end
